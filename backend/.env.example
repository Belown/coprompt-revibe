# Copy to backend/.env and run compose with it:  docker compose --env-file backend/.env up -d --build
# (--env-file feeds the ${...} in docker-compose.yml; env_file passes the same values into the container)

# Port the server listens on. Compose publishes it on 127.0.0.1 only; put a reverse proxy / tunnel in front.
PORT=8787

# Host directory for room data (one <room>.json per room), bind-mounted to /data in the container.
# The container runs as uid 1000 (user "node"): mkdir -p <dir> && sudo chown 1000:1000 <dir>
HOST_DATA_DIR=/srv/coprompt/data

# Where the server writes room files. Inside the container this is the mount point; leave it.
# When running without Docker (npm start) the default is ./data next to server.js.
DATA_DIR=/data

# Comma-separated Origin headers allowed to open a WebSocket. Anything else gets 403.
ALLOWED_ORIGINS=https://app.coprompt-revibe.wangleishen.com,https://belown.github.io,http://localhost:8000

# Limits (defaults shown)
# largest single message; a block carries its outputs (plots) and history
MAX_MSG_BYTES=2097152
# connections per room
MAX_CONN_PER_ROOM=20
# room files on disk; new rooms beyond this are refused
MAX_ROOMS=100
# messages per second per connection, sustained (token bucket)
MSG_RATE=20
# bucket size; a reconnect resends every locally newer object at once
MSG_BURST=200
# ping interval; a connection that misses one pong is dropped
HEARTBEAT_MS=30000
