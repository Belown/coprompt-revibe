# Copy to .env (next to docker-compose.yml; compose reads it automatically), edit, then:
#   docker compose up -d
# New versions deploy themselves after a push to main (the deploy service); by hand: git pull && docker compose up -d --build

# Host port the web container (Caddy) is published on, bound to 127.0.0.1 only.
# Point Cloudflare Tunnel or the host's reverse proxy at http://127.0.0.1:<HTTP_PORT>; it terminates TLS.
HTTP_PORT=8080

# Host directory for room data (one <room>.json per room), mounted at /data in the sync container.
# Leave it out to keep the rooms in the Docker volume "rooms" instead.
# The container runs as uid 1000 (user "node"): mkdir -p <dir> && sudo chown 1000:1000 <dir>
# Use an ABSOLUTE path as the Docker daemon sees it. A relative one (./data) works by hand but breaks after an
# auto-deploy: the deploy service runs compose from /repo inside its container, so ./data becomes /repo/data on the
# Docker host, a new root-owned folder the sync server cannot write. Docker Desktop on Windows: C:\x\data is
# /run/desktop/mnt/host/c/x/data.
HOST_DATA_DIR=/srv/coprompt-revibe/data

# ---- sync backend (only reachable through Caddy at /api; its own port is fixed to 8787 in compose) ----

# Comma-separated Origin headers allowed to open a WebSocket. Anything else gets 403.
ALLOWED_ORIGINS=https://coprompt-revibe.wangleishen.com,http://localhost:8000

# Limits (defaults shown)
# largest single message; a block carries its outputs (plots) and history
MAX_MSG_BYTES=2097152
# connections per room
MAX_CONN_PER_ROOM=20
# room files on disk; at the cap, a new room deletes the least recently used one nobody is in
MAX_ROOMS=100
# a room nobody has used for this many days is deleted (checked at start and hourly)
ROOM_TTL_DAYS=7
# bytes per room (RAM and disk); a write that would pass it is refused
MAX_ROOM_BYTES=20971520
# messages per second per connection, sustained (token bucket); typing sends up to 10, the mouse pointer 10
MSG_RATE=30
# bucket size; a reconnect resends every locally newer object at once
MSG_BURST=200
# ping interval; a connection that misses one pong is dropped
HEARTBEAT_MS=30000

# ---- LLM proxy (backend/llm.js): lets people use the app without their own API key ----
# Leave a key empty and the server offers nothing for that provider; people then enter their own key in the app
# (API key button). Someone who enters their own key always uses it, not the server's.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# models the server pays for (claude-* need ANTHROPIC_API_KEY)
LLM_MODELS=deepseek-flash,deepseek-v4-pro
# optional shared code; if set, people type it once into the API key dialog. Empty = anyone on the site can use the key.
LLM_ACCESS_CODE=
# calls per day (UTC) for everyone together: this bounds the bill. Resets on server restart.
LLM_DAILY_LIMIT=1000
# calls per minute per IP (a seminar room may share one public IP)
LLM_PER_MIN=60
# output tokens per call, at most
LLM_MAX_TOKENS=16000

# PORT and DATA_DIR are read by backend/server.js too (defaults 8787 and ./data, for npm start);
# compose sets them for the container.

# ---- auto-deploy (the deploy service) ----
# Only if the repo turns private: a fine-grained token from github.com/settings/tokens, this repo only, Contents read-only.
GITHUB_TOKEN=
