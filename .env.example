# Copy to .env (next to docker-compose.yml; compose reads it automatically), edit, then:
#   docker compose up -d --build
# To deploy a new version: git pull && docker compose up -d --build

# Host port the web container (Caddy) is published on, bound to 127.0.0.1 only.
# Point Cloudflare Tunnel or the host's reverse proxy at http://127.0.0.1:<HTTP_PORT>; it terminates TLS.
HTTP_PORT=8080

# Host directory for room data (one <room>.json per room), mounted at /data in the sync container.
# The container runs as uid 1000 (user "node"): mkdir -p <dir> && sudo chown 1000:1000 <dir>
HOST_DATA_DIR=/srv/coprompt-revibe/data

# ---- sync backend (only reachable through Caddy at /api; its own port is fixed to 8787 in compose) ----

# Comma-separated Origin headers allowed to open a WebSocket. Anything else gets 403.
ALLOWED_ORIGINS=https://coprompt-revibe.wangleishen.com,http://localhost:8000

# Limits (defaults shown)
# largest single message; a block carries its outputs (plots) and history
MAX_MSG_BYTES=2097152
# connections per room
MAX_CONN_PER_ROOM=20
# room files on disk; new rooms beyond this are refused
MAX_ROOMS=100
# messages per second per connection, sustained (token bucket)
MSG_RATE=20
# bucket size; a reconnect resends every locally newer object at once
MSG_BURST=200
# ping interval; a connection that misses one pong is dropped
HEARTBEAT_MS=30000

# PORT and DATA_DIR are read by backend/server.js too (defaults 8787 and ./data, for npm start);
# compose sets them for the container.
