# Serves the built frontend and proxies /api to the sync backend. Plain HTTP: TLS is terminated in front of it
# (Cloudflare Tunnel or a host proxy), which is why compose publishes it on 127.0.0.1 only.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# sync backend: WebSocket at /api/?room=…, health at /api/health (the prefix is stripped)
	handle_path /api/* {
		reverse_proxy sync:8787
	}

	# GitHub Actions calls this after a push to main (the deploy service in docker-compose.yml). It can only make the
	# server check GitHub, so it needs no password.
	handle /_deploy {
		reverse_proxy deploy:9000
	}

	# blog at /, app at /app/
	handle {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
